{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GodSpeed Project Template",
  "version": "0.1.0",
  "identifier": "ai.godspeed.projecttemplate",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "GodSpeed Project Template",
      "width": 1120,
      "height": 800,
      "minWidth": 650,
      "minHeight": 480
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:3000 ws://127.0.0.1:5173 http://127.0.0.1:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
