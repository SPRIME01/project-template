{
  "name": "godspeed-project-template",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun run --filter @template/api dev",
    "dev:web": "bun run --filter @template/web dev",
    "db:migrate": "bun run packages/db/src/migrate.ts",
    "db:smoke": "bun run packages/db/src/smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "build": "bun run --filter @template/web build",
    "check": "bun run typecheck && bun run test && bun run build",
    "desktop:dev": "bun run --filter @template/web desktop:dev",
    "desktop:build": "bun run --filter @template/web desktop:build",
    "cli": "bun run apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
