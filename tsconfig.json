{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": ["packages/**/*.ts", "apps/api/src/**/*.ts", "apps/cli/src/**/*.ts"],
  "exclude": ["node_modules", "apps/web", "**/dist/**"]
}
